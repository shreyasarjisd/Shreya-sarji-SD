{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile for patient or doctor",
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["patient", "doctor"] },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "age": { "type": "number" },
        "gender": { "type": "string" },
        "bloodGroup": { "type": "string" },
        "address": { "type": "string" },
        "degree": { "type": "string" },
        "isSharingEnabled": { "type": "boolean" },
        "onboarded": { "type": "boolean" }
      },
      "required": ["role", "name", "email"]
    },
    "Record": {
      "title": "Medical Record",
      "description": "A medical report or prescription uploaded by a patient",
      "type": "object",
      "properties": {
        "patientId": { "type": "string" },
        "fileURL": { "type": "string" },
        "fileName": { "type": "string" },
        "type": { "type": "string", "enum": ["prescription", "report"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["patientId", "fileURL", "type", "createdAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "records/{recordId}": {
      "schema": "Record",
      "description": "Medical records"
    }
  }
}
